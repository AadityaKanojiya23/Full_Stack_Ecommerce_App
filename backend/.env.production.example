# ==============================================================================
# 🚀 AMORE SHOP OFFICIAL / SWEETCRAVE BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to '.env' or copy these variables into your hosting platform's 
# environment settings dashboard (e.g. Render, Railway, or Heroku).

# Node environment setting
NODE_ENV=production

# Server Port (Render and Railway inject this automatically, leave as PORT)
PORT=5000

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONNECTION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Connects backend server securely to MongoDB Atlas database cloud cluster.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
# Ensure you replace <username>, <password>, and <cluster-url> with your live credentials.
MONGO_URI=mongodb+srv://amore_admin:your_secure_password@cluster0.abcde.mongodb.net/amore_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 🔒 SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Symmetric encryption key used for signing JWT login authorization tokens.
# Use a highly cryptographic 64-character hex key. You can generate one with:
# Terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=fdf46bf29910d6e273030f6a27fe0de8001d1679059f365dbef40c6b0486c9d0

# ------------------------------------------------------------------------------
# 🌐 CORS ORIGIN CONTROL
# ------------------------------------------------------------------------------
# Defines the absolute URL of the hosted frontend client allowed to query this API.
# Replace with your actual frontend address on Vercel. 
# Do NOT include a trailing slash!
FRONTEND_URL=https://amore-shop-official.vercel.app

# ------------------------------------------------------------------------------
# ☁️ CLOUDINARY IMAGE STORAGE
# ------------------------------------------------------------------------------
# Cloudinary credentials utilized for hosting product cakes, custom banners, and reviews.
# Find these in your Cloudinary Dashboard under API Keys.
CLOUDINARY_CLOUD_NAME=amore_cakes_cloudinary_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key

# ------------------------------------------------------------------------------
# 💳 RAZORPAY PRODUCTION GATEWAY
# ------------------------------------------------------------------------------
# Production-ready credentials for the online checkout system.
# Register and download API Keys from the Razorpay Dashboard (Settings -> API Keys).
# Supports test keys (rzp_test_...) for staging or live keys (rzp_live_...) for production.
RAZORPAY_KEY_ID=rzp_live_your_actual_production_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret_key
